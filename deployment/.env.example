# ─────────────────────────────────────────────────────────────────────────────
# Shopizer Local CD – Environment Variables
# Copy to .env and fill in values before running docker compose.
#
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Image versions ────────────────────────────────────────────────────────────
# Format: {semver}-{short-sha}   e.g. 3.2.5-a1b2c3d4
# Set to 'latest' to use the most recently loaded image.
IMAGE_TAG_BACKEND=ci-latest
# Admin UI (Angular) image
IMAGE_TAG_ADMIN=ci-latest
# React Shop image
IMAGE_TAG_SHOP=ci-latest

# ── MySQL ─────────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root_change_me
MYSQL_DATABASE=SALESMANAGER
MYSQL_USER=shopizer
MYSQL_PASSWORD=shopizer_change_me

# ── Spring profiles ───────────────────────────────────────────────────────────
# 'default' uses H2 in the original app; switch to 'mysql' or custom profile
# if you have a MySQL profile configured in your application.yml
SPRING_PROFILES_ACTIVE=default

# ── Service ports (local host) ────────────────────────────────────────────────
ADMIN_PORT=8081
SHOP_PORT=8082
# Backend is always on 8080 (see docker-compose.yml)

# ── GitHub repo info (used by deploy-local.sh) ────────────────────────────────
# These must match the actual GitHub repository paths (owner/repo).
GITHUB_REPO_BACKEND=kumarsaroj18/shopizer
# The combined frontend image (shopizer-frontend) is produced by cd-frontend.yml
# which lives in shopizer-admin. deploy-local.sh downloads image tars from there.
GITHUB_REPO_FRONTEND=kumarsaroj18/shopizer-admin
